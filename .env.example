# CrisisIQ Environment Configuration
# Target Problem: SIH26192 - Flash Flood Prediction System for Hilly Regions using Multi-Source Data

# Database & Cache (Optional - in-memory fallback enabled by default)
MONGO_URI=mongodb://localhost:27017/crisisiq
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Backend (Node/Express Server)
PORT=3001
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_token_secret_here
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# AI Engine (Python / FastAPI Service)
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_PORT=8000
USE_MOCK_LLM=true
FLOOD_MODEL_PATH=src/models/flood_risk_rf.joblib

# External APIs (Optional placeholders - System works offline in Demo Mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Alert & Notification Gateways (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_here
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here

# Firebase Push Notifications (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key
